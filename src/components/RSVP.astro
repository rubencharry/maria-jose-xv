---
const whatsappPhone = '3150602339';
---

<section class="px-6 py-6" data-purpose="rsvp-confirmation" id="rsvp-section">
  <div class="bg-white/95 rounded-2xl p-6 gold-foil-border shadow-soft-card text-center">
    <span class="font-script text-3xl text-gold-600 block mb-1">Confirmación</span>
    <h3 class="font-cinzel text-sm font-bold uppercase tracking-widest text-deep-charcoal mb-2">¿Nos Acompañas?</h3>
    <p class="text-xs text-muted-slate mb-5">
      Por favor confírmanos tu asistencia antes del <strong>5 de Diciembre de 2026</strong> para considerarte en el
      banquete.
    </p>

    <form class="space-y-3.5 text-left" id="rsvpForm" data-phone={whatsappPhone}>

      <!-- Select de familia -->
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted-slate mb-1" for="familiaSelect">
          Buscar por representante
        </label>
        <div class="relative">
          <select
            class="w-full text-xs rounded-xl border-powder-blue-300 focus:border-gold-500 focus:ring focus:ring-gold-300/30 px-3 py-2.5 bg-powder-blue-50/30 appearance-none disabled:opacity-60"
            id="familiaSelect"
            disabled
          >
            <option value="">Cargando...</option>
          </select>
          <!-- Ícono chevron -->
          <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-slate">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Tarjeta personalizada de invitación -->
      <div id="queridosContainer" class="hidden">
        <div class="relative bg-gradient-to-b from-powder-blue-50/80 to-white rounded-2xl px-5 pt-6 pb-5 border border-powder-blue-200 text-center overflow-hidden">

          <!-- Flores esquinas -->
          <img
            src="/flores/flor-esquina-inferior.webp"
            alt=""
            aria-hidden="true"
            class="absolute -top-5 -left-5 w-[36%] h-auto pointer-events-none select-none opacity-90 [transform:scaleY(-1)]"
            loading="lazy"
          />
          <img
            src="/flores/flor-esquina-inferior.webp"
            alt=""
            aria-hidden="true"
            class="absolute -bottom-5 -right-5 w-[36%] h-auto pointer-events-none select-none opacity-90 [transform:scaleX(-1)]"
            loading="lazy"
          />

          <!-- Ornamento superior -->
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="block h-px w-8 bg-gold-300"></span>
            <svg class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5z"/>
            </svg>
            <span class="block h-px w-8 bg-gold-300"></span>
          </div>

          <!-- Título "Queridos:" -->
          <p class="font-script text-[1.7rem] text-gold-600 leading-tight mb-1">Queridos:</p>

          <!-- Instrucción -->
          <p class="text-[10px] text-muted-slate/80 mb-3">Marca quienes confirman asistencia</p>

          <!-- Lista de integrantes con checks -->
          <ul id="integrantesList" class="text-left space-y-1.5 mb-4"></ul>

          <!-- Divisor -->
          <div class="flex items-center justify-center gap-2 mb-3">
            <span class="block h-px w-12 bg-powder-blue-200"></span>
            <span class="text-powder-blue-300 text-[10px]">✦</span>
            <span class="block h-px w-12 bg-powder-blue-200"></span>
          </div>

          <!-- Mensaje cálido -->
          <p class="font-cormorant text-[1rem] italic text-muted-slate leading-relaxed mb-1">
            Con mucho cariño los esperamos para acompañarnos<br/>
            en este día tan especial. ¡Será un honor compartirlo con ustedes!
          </p>
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted-slate mb-1" for="guestMessage">
          Mensaje de Felicitación (Opcional)
        </label>
        <textarea
          class="w-full text-xs rounded-xl border-powder-blue-300 focus:border-gold-500 focus:ring focus:ring-gold-300/30 px-3 py-2 bg-powder-blue-50/30"
          id="guestMessage"
          placeholder="¡Felicidades Maria José en tus 15 años!"
          rows="2"
        ></textarea>
      </div>

      <button
        class="w-full mt-2 py-3 px-4 bg-gradient-to-r from-gold-500 via-gold-600 to-gold-500 hover:opacity-95 text-white font-cinzel text-xs font-bold uppercase tracking-widest rounded-xl shadow-gold-glow transition-all transform active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed"
        id="submitBtn"
        type="submit"
      >
        <span id="submitLabel">Confirmar Asistencia</span>
        <svg class="w-4 h-4" id="submitIcon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </button>
    </form>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const familiaSelect     = document.getElementById('familiaSelect')     as HTMLSelectElement;
  const queridosContainer = document.getElementById('queridosContainer') as HTMLDivElement;
  const integrantesList   = document.getElementById('integrantesList')   as HTMLUListElement;

  const integrantesCache = new Map<string, string[]>();

  // ---------------------------------------------------------------------------
  // Checklist
  // ---------------------------------------------------------------------------
  function renderChecklist(nombres: string[]) {
    integrantesList.innerHTML = '';

    nombres.forEach((nombre, i) => {
      const id = `inv-${i}`;

      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 px-1';

      const checkbox = document.createElement('input');
      checkbox.type    = 'checkbox';
      checkbox.id      = id;
      checkbox.name    = 'integrante';
      checkbox.value   = nombre;
      checkbox.checked = false;
      checkbox.className =
        'w-4 h-4 rounded border-gold-400 text-gold-500 focus:ring-gold-300/40 flex-shrink-0 cursor-pointer accent-amber-500';

      const label = document.createElement('label');
      label.htmlFor     = id;
      label.textContent = nombre;
      label.className   = 'font-cormorant text-[1rem] text-deep-charcoal cursor-pointer select-none';

      li.appendChild(checkbox);
      li.appendChild(label);
      integrantesList.appendChild(li);
    });
  }

  function nombresSeleccionados(): string[] {
    return Array.from(
      integrantesList.querySelectorAll<HTMLInputElement>('input[name="integrante"]:checked')
    ).map(cb => cb.value);
  }

  // ---------------------------------------------------------------------------
  // Datos
  // ---------------------------------------------------------------------------
  async function cargarIntegrantes(familiaId: string): Promise<string[]> {
    if (integrantesCache.has(familiaId)) return integrantesCache.get(familiaId)!;

    const { data, error } = await supabase
      .from('integrantes')
      .select('nombre')
      .eq('familia_id', familiaId);

    if (error) { console.error(error); return []; }

    const nombres = (data ?? []).map((i: { nombre: string }) => i.nombre);
    integrantesCache.set(familiaId, nombres);
    return nombres;
  }

  async function inicializar() {
    const { data, error } = await supabase
      .from('familias')
      .select('id, representante')
      .order('representante');

    familiaSelect.innerHTML = '';

    if (error || !data || data.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = error ? 'Error al cargar' : 'Sin invitados registrados aún';
      familiaSelect.appendChild(opt);
      familiaSelect.disabled = true;
      return;
    }

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = '— Busca tu nombre como representante —';
    familiaSelect.appendChild(placeholder);

    data.forEach((f: { id: string; representante: string }) => {
      const opt = document.createElement('option');
      opt.value = f.id;
      opt.textContent = f.representante;
      familiaSelect.appendChild(opt);
    });

    familiaSelect.disabled = false;
  }

  // ---------------------------------------------------------------------------
  // Eventos
  // ---------------------------------------------------------------------------
  familiaSelect.addEventListener('change', async () => {
    const familiaId = familiaSelect.value;

    if (!familiaId) {
      queridosContainer.classList.add('hidden');
      integrantesList.innerHTML = '';
      return;
    }

    queridosContainer.classList.remove('hidden');
    integrantesList.innerHTML = '<li class="text-xs text-muted-slate italic px-1">Cargando invitados...</li>';

    const nombres = await cargarIntegrantes(familiaId);
    renderChecklist(nombres);
  });

  const form       = document.getElementById('rsvpForm')   as HTMLFormElement;
  const submitBtn  = document.getElementById('submitBtn')   as HTMLButtonElement;
  const submitLabel= document.getElementById('submitLabel') as HTMLSpanElement;
  const submitIcon = document.getElementById('submitIcon')  as unknown as SVGElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const familiaId     = familiaSelect.value;
    const seleccionados = nombresSeleccionados();
    const mensaje       = (document.getElementById('guestMessage') as HTMLTextAreaElement).value.trim();

    if (!familiaId) {
      familiaSelect.classList.add('ring-2', 'ring-red-300', 'border-red-400');
      setTimeout(() => familiaSelect.classList.remove('ring-2', 'ring-red-300', 'border-red-400'), 2000);
      return;
    }

    if (seleccionados.length === 0) return;

    // Estado: enviando
    submitBtn.disabled    = true;
    submitLabel.textContent = 'Enviando…';

    const { error } = await supabase.from('confirmaciones').insert({
      familia_id: familiaId,
      asistentes: seleccionados,
      mensaje:    mensaje || null,
    });

    if (error) {
      console.error(error);
      submitLabel.textContent = 'Error al enviar';
      submitBtn.disabled = false;
      return;
    }

    // Notificación WhatsApp al organizador
    const familiaNombre = familiaSelect.selectedOptions[0]?.textContent ?? '';
    const lista = seleccionados.length === 1
      ? seleccionados[0]
      : seleccionados.slice(0, -1).join(', ') + ' y ' + seleccionados[seleccionados.length - 1];
    const phone = form.dataset.phone ?? '';
    let msg = `✅ Nueva confirmación XV María José%0A%0A`;
    msg += `*Representante:* ${encodeURIComponent(familiaNombre)}%0A`;
    msg += `*Asistirán (${seleccionados.length}):* ${encodeURIComponent(lista)}%0A`;
    if (mensaje) msg += `*Mensaje:* ${encodeURIComponent(mensaje)}%0A`;
    window.open(`https://wa.me/57${phone}?text=${msg}`, '_blank');

    // Estado: confirmado ✓
    submitBtn.classList.remove('from-gold-500', 'via-gold-600', 'to-gold-500', 'shadow-gold-glow');
    submitBtn.classList.add('from-emerald-500', 'via-emerald-600', 'to-emerald-500');
    submitLabel.textContent = '¡Confirmado!';
    submitIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>';
    submitBtn.disabled = true;
  });

  inicializar();
</script>
