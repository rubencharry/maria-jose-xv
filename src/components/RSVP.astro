---
const whatsappPhone = '5215512345678';
---

<section class="px-6 py-6" data-purpose="rsvp-confirmation" id="rsvp-section">
  <div class="bg-white/95 rounded-2xl p-6 gold-foil-border shadow-soft-card text-center">
    <span class="font-script text-3xl text-gold-600 block mb-1">Confirmación</span>
    <h3 class="font-cinzel text-sm font-bold uppercase tracking-widest text-deep-charcoal mb-2">¿Nos Acompañas?</h3>
    <p class="text-xs text-muted-slate mb-5">
      Por favor confírmanos tu asistencia antes del <strong>19 de Diciembre de 2026</strong> para considerarte en el
      banquete.
    </p>

    <form class="space-y-3.5 text-left" id="rsvpForm" data-phone={whatsappPhone}>

      <!-- Select de familia -->
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted-slate mb-1" for="familiaSelect">
          Familia o Grupo
        </label>
        <div class="relative">
          <select
            class="w-full text-xs rounded-xl border-powder-blue-300 focus:border-gold-500 focus:ring focus:ring-gold-300/30 px-3 py-2.5 bg-powder-blue-50/30 appearance-none disabled:opacity-60"
            id="familiaSelect"
            disabled
          >
            <option value="">Cargando familias...</option>
          </select>
          <!-- Ícono chevron -->
          <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-slate">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Tarjeta personalizada de invitación -->
      <div id="queridosContainer" class="hidden">
        <div class="relative bg-gradient-to-b from-powder-blue-50/80 to-white rounded-2xl px-5 pt-5 pb-4 border border-powder-blue-200 text-center overflow-hidden">

          <!-- Ornamento superior -->
          <div class="flex items-center justify-center gap-2 mb-3">
            <span class="block h-px w-8 bg-gold-300"></span>
            <svg class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5z"/>
            </svg>
            <span class="block h-px w-8 bg-gold-300"></span>
          </div>

          <!-- Lista de integrantes con checks -->
          <ul id="integrantesList" class="text-left space-y-1.5 mb-4"></ul>

          <!-- Divisor -->
          <div class="flex items-center justify-center gap-2 mb-3">
            <span class="block h-px w-12 bg-powder-blue-200"></span>
            <span class="text-powder-blue-300 text-[10px]">✦</span>
            <span class="block h-px w-12 bg-powder-blue-200"></span>
          </div>

          <!-- Mensaje cálido -->
          <p class="font-cormorant text-sm italic text-muted-slate leading-relaxed mb-3">
            Con mucho cariño los esperamos para acompañarnos<br/>
            en este día tan especial. ¡Será un honor compartirlo con ustedes!
          </p>

          <!-- Decoración de fondo sutil -->
          <div class="absolute -bottom-3 -right-3 w-20 h-20 rounded-full bg-powder-blue-100/40 blur-xl pointer-events-none"></div>
          <div class="absolute -top-3 -left-3 w-16 h-16 rounded-full bg-gold-300/20 blur-xl pointer-events-none"></div>
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wider text-muted-slate mb-1" for="guestMessage">
          Mensaje de Felicitación (Opcional)
        </label>
        <textarea
          class="w-full text-xs rounded-xl border-powder-blue-300 focus:border-gold-500 focus:ring focus:ring-gold-300/30 px-3 py-2 bg-powder-blue-50/30"
          id="guestMessage"
          placeholder="¡Felicidades Maria José en tus 15 años!"
          rows="2"
        ></textarea>
      </div>

      <button
        class="w-full mt-2 py-3 px-4 bg-gradient-to-r from-gold-500 via-gold-600 to-gold-500 hover:opacity-95 text-white font-cinzel text-xs font-bold uppercase tracking-widest rounded-xl shadow-gold-glow transition-all transform active:scale-[0.98] flex items-center justify-center space-x-2"
        type="submit"
      >
        <span>Confirmar por WhatsApp</span>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.586 1.761.882 2.79.882h.001c3.181 0 5.768-2.586 5.768-5.766 0-3.18-2.587-5.768-5.768-5.768zm0 10.355c-.933 0-1.748-.276-2.454-.739l-.176-.115-1.572.412.419-1.533-.127-.184c-.524-.761-.801-1.472-.801-2.43 0-2.527 2.056-4.583 4.584-4.583 2.527 0 4.583 2.056 4.583 4.583 0 2.528-2.056 4.584-4.583 4.584zm2.513-3.444c-.138-.069-.817-.404-.944-.45-.126-.046-.219-.069-.311.069-.092.138-.357.45-.438.542-.08.092-.161.103-.299.034-.138-.069-.583-.215-1.111-.685-.411-.366-.689-.817-.769-.955-.08-.138-.009-.213.06-.282.063-.062.138-.161.207-.241.069-.08.092-.138.138-.23.046-.092.023-.172-.011-.241s-.311-.75-.426-1.026c-.112-.269-.226-.233-.311-.237l-.265-.005c-.092 0-.241.034-.368.172-.126.138-.483.472-.483 1.15 0 .679.494 1.335.563 1.427.069.092.973 1.486 2.357 2.084.329.143.587.228.787.292.331.105.632.09.871.054.266-.04.817-.334.932-.656.115-.322.115-.598.08-.656-.034-.057-.126-.092-.264-.161z"></path>
        </svg>
      </button>
    </form>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const familiaSelect = document.getElementById('familiaSelect') as HTMLSelectElement;
  const queridosContainer = document.getElementById('queridosContainer') as HTMLDivElement;
  const queridosText = document.getElementById('queridosText') as HTMLParagraphElement;
  const guestCount = document.getElementById('guestCount') as HTMLInputElement;

  // Cache para no repetir queries de integrantes
  const integrantesCache = new Map<string, string[]>();

  function formatearIntegrantes(nombres: string[]): string {
    if (nombres.length === 0) return '';
    if (nombres.length === 1) return `Querido/a: ${nombres[0]}`;
    const ultimo = nombres[nombres.length - 1];
    const anteriores = nombres.slice(0, -1).join(', ');
    return `Queridos: ${anteriores} y ${ultimo}`;
  }

  async function cargarIntegrantes(familiaId: string): Promise<string[]> {
    if (integrantesCache.has(familiaId)) return integrantesCache.get(familiaId)!;

    const { data, error } = await supabase
      .from('integrantes')
      .select('nombre')
      .eq('familia_id', familiaId);

    if (error) { console.error(error); return []; }

    const nombres = (data ?? []).map((i: { nombre: string }) => i.nombre);
    integrantesCache.set(familiaId, nombres);
    return nombres;
  }

  async function inicializar() {
    const { data, error } = await supabase
      .from('familias')
      .select('id, nombre')
      .order('nombre');

    familiaSelect.innerHTML = '';

    if (error || !data || data.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = error ? 'Error al cargar familias' : 'Sin familias registradas aún';
      familiaSelect.appendChild(opt);
      familiaSelect.disabled = true;
      return;
    }

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = '— Selecciona tu familia o grupo —';
    familiaSelect.appendChild(placeholder);

    data.forEach((f: { id: string; nombre: string }) => {
      const opt = document.createElement('option');
      opt.value = f.id;
      opt.textContent = f.nombre;
      familiaSelect.appendChild(opt);
    });

    familiaSelect.disabled = false;
  }

  familiaSelect.addEventListener('change', async () => {
    const familiaId = familiaSelect.value;

    if (!familiaId) {
      queridosContainer.classList.add('hidden');
      return;
    }

    queridosContainer.classList.remove('hidden');
    queridosText.textContent = 'Cargando invitados...';

    const nombres = await cargarIntegrantes(familiaId);
    queridosText.textContent = formatearIntegrantes(nombres);

    if (nombres.length > 0) {
      guestCount.value = String(nombres.length);
    }
  });

  const form = document.getElementById('rsvpForm') as HTMLFormElement;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const familiaId = familiaSelect.value;
    const familiaNombre = familiaSelect.selectedOptions[0]?.textContent ?? '';
    const status = (document.getElementById('attendingStatus') as HTMLSelectElement).value;
    const count = (document.getElementById('guestCount') as HTMLInputElement).value;
    const message = (document.getElementById('guestMessage') as HTMLTextAreaElement).value.trim();
    const phone = form.dataset.phone ?? '5215512345678';

    if (!familiaId) {
      familiaSelect.classList.add('ring', 'ring-red-300', 'border-red-400');
      setTimeout(() => familiaSelect.classList.remove('ring', 'ring-red-300', 'border-red-400'), 2000);
      return;
    }

    let text = `¡Hola! Confirmo la asistencia para los XV Años de Maria José:%0A%0A`;
    text += `*Familia / Grupo:* ${encodeURIComponent(familiaNombre)}%0A`;
    text += `*Respuesta:* ${encodeURIComponent(status)}%0A`;
    text += `*Pases confirmados:* ${encodeURIComponent(count)}%0A`;
    if (message) text += `*Mensaje:* ${encodeURIComponent(message)}%0A`;

    window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
  });

  inicializar();
</script>
