---
interface Props {
  src: string;
  quote?: string;
  position?: string;
}
const {
  src,
  quote,
  position = 'center',
} = Astro.props;
---

<section class="relative w-full overflow-hidden" data-purpose="photo-break">
  <!-- La imagen determina la altura de la sección -->
  <img
    src={src}
    alt=""
    aria-hidden="true"
    class="w-full h-auto block"
    loading="lazy"
  />

  <!-- Overlay degradado suave arriba y abajo -->
  <div class="absolute inset-0 bg-gradient-to-b from-white/25 via-transparent to-white/35 pointer-events-none"></div>

  {quote && (
    <div class="absolute inset-0 flex items-end justify-center pb-8 px-6">
      <div class="text-center">
        <div class="flex items-center justify-center gap-3 mb-2">
          <span class="block h-px w-10 bg-white/70"></span>
          <svg class="w-3 h-3 text-white/80 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5z"/>
          </svg>
          <span class="block h-px w-10 bg-white/70"></span>
        </div>
        <p class="font-script text-3xl text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] leading-tight">
          {quote}
        </p>
      </div>
    </div>
  )}
</section>
