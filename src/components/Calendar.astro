---
// Dec 1, 2026 = Tuesday → Monday-first offset = (2+6)%7 = 1
const offset = 1;
const daysInMonth = 31;
const eventDay = 19;

const dayHeaders = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do'];
// Saturday is column index 5 (0-based Mon-first)
const eventColIndex = 5;

type Cell = number | null;
const cells: Cell[] = [
  ...Array(offset).fill(null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
while (cells.length % 7 !== 0) cells.push(null);
---

<section class="px-6 py-5" data-purpose="event-calendar">
  <div class="bg-white/80 rounded-2xl p-5 gold-foil-border shadow-soft-card">

    <!-- Header -->
    <div class="text-center mb-4">
      <p class="font-cinzel text-[14px] font-bold uppercase tracking-[0.22em] text-gold-600 mb-0.5">
        El Gran Día
      </p>
      <p class="font-cormorant text-2xl font-semibold text-deep-charcoal leading-tight">
        Diciembre 2026
      </p>
    </div>

    <!-- Day-of-week headers -->
    <div class="grid grid-cols-7 mb-1">
      {dayHeaders.map((d, i) => (
        <div
          class:list={[
            "text-center text-[10px] font-cinzel font-semibold py-1 tracking-wide",
            i === eventColIndex ? "text-gold-600" : "text-muted-slate/70",
          ]}
        >
          {d}
        </div>
      ))}
    </div>

    <!-- Calendar grid -->
    <div class="grid grid-cols-7">
      {cells.map((day, idx) => {
        const col = idx % 7;
        const isEvent = day === eventDay;
        const isSat = col === eventColIndex;

        return day === null ? (
          <div class="h-9" />
        ) : isEvent ? (
          <div class="h-9 flex items-center justify-center relative">
            <svg
              class="w-8 h-8 drop-shadow-[0_2px_4px_rgba(200,163,85,0.45)]"
              style="margin-left: -2px;"
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <linearGradient id="heartGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#DFC27C" />
                  <stop offset="100%" stop-color="#B0883B" />
                </linearGradient>
              </defs>
              <path
                d="M16 27 C16 27 4 19 4 11.5 C4 7.5 7 5 10.5 5 C13 5 15 6.5 16 8 C17 6.5 19 5 21.5 5 C25 5 28 7.5 28 11.5 C28 19 16 27 16 27Z"
                fill="url(#heartGrad)"
              />
            </svg>
            <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-cinzel text-[10px] font-bold text-white leading-none">
              {day}
            </span>
          </div>
        ) : (
          <div class="h-9 flex items-center justify-center">
            <span
              class:list={[
                "font-sans text-[11px]",
                isSat ? "text-gold-600/70 font-medium" : "text-deep-charcoal/60",
              ]}
            >
              {day}
            </span>
          </div>
        );
      })}
    </div>

  </div>
</section>
