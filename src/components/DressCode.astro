---
---

<section class="px-6 py-5" data-purpose="dress-code">
  <div class="bg-white/90 rounded-2xl p-6 gold-foil-border shadow-soft-card text-center relative overflow-hidden">

    <span class="font-cinzel text-xs font-semibold uppercase tracking-widest text-gold-600 block mb-1">
      Código de Vestimenta
    </span>
    <h3 class="font-cormorant text-2xl font-bold text-deep-charcoal mb-5">
      Black Elegance
    </h3>

    <!-- Siluetas -->
    <div class="flex justify-center items-end gap-1 mb-5">

      <!-- Caballero (traje) -->
      <div class="flex flex-col items-center gap-2">
        <svg class="w-9 h-12 text-deep-charcoal" viewBox="0 0 60 85" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <!-- cabeza -->
          <ellipse cx="30" cy="11" rx="9" ry="10"/>
          <!-- chaqueta izquierda -->
          <path d="M30 21 L21 21 L7 33 L7 80 L30 80 Z"/>
          <!-- chaqueta derecha -->
          <path d="M30 21 L39 21 L53 33 L53 80 L30 80 Z"/>
          <!-- camisa (área V entre solapas) -->
          <path d="M30 21 L26 31 L30 46 L34 31 Z" fill="white" opacity="0.25"/>
          <!-- corbatín -->
          <path d="M24 23 L30 27 L36 23 L30 19 Z"/>
        </svg>
      </div>

      <!-- Dama (vestido) -->
      <div class="flex flex-col items-center gap-2">
        <svg class="w-9 h-12 text-deep-charcoal" viewBox="0 0 60 85" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <!-- cabeza -->
          <ellipse cx="30" cy="11" rx="9" ry="10"/>
          <!-- cuerpo / corpiño -->
          <path d="M22 21 L38 21 L43 44 L17 44 Z"/>
          <!-- falda / skirt -->
          <path d="M17 44 L43 44 L60 80 L0 80 Z"/>
        </svg>
      </div>

    </div>

    <p class="text-xs text-muted-slate leading-relaxed">
      Agradecemos vestir traje negro para caballeros<br/>y vestido negro para damas.
    </p>

  </div>
</section>
