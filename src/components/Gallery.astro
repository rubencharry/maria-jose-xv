---
const images = [
  '/img/maria-jose-1.webp',
  '/img/maria-jose-2.webp',
  '/img/maria-jose-3.webp',
  '/img/maria-jose-4.webp',
  '/img/maria-jose-5.webp',
  '/img/maria-jose-6.webp',
  '/img/maria-jose-7.webp',
  '/img/maria-jose-8.webp',
  '/img/maria-jose-9.webp',
  '/img/maria-jose-10.webp',
];
// Clonar la primera al final para que el loop sea seamless
const slides = [...images, images[0]];
const TOTAL = slides.length; // 11
const REAL  = images.length; // 10
---

<section class="px-6 py-6" data-purpose="gallery-highlight">

  <div class="text-center mb-5">
    <p class="font-script text-5xl text-gold-600 mt-0.5">-Galería-</p>
  </div>

  <!-- Slider -->
  <div class="rounded-2xl bg-white/85 p-2 gold-foil-border shadow-soft-card">
    <div class="overflow-hidden rounded-xl">
      <div
        id="gallery-strip"
        class="flex"
        style={`width:${TOTAL * 100}%; transform:translateX(0); transition:transform 700ms ease-in-out;`}
      >
        {slides.map((src, i) => (
          <div class="flex-shrink-0" style={`width:${100 / TOTAL}%`}>
            <div class="aspect-[3/4]">
              <img
                src={src}
                alt={`Maria José foto ${(i % REAL) + 1}`}
                class="w-full h-full object-cover object-center"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Indicadores -->
  <div class="flex justify-center gap-1.5 mt-3" id="gallery-dots">
    {images.map((_, i) => (
      <button
        class={`rounded-full transition-all duration-300 ${i === 0 ? 'h-1.5 w-4 bg-gold-500' : 'h-2 w-2 bg-gold-300'}`}
        aria-label={`Foto ${i + 1}`}
      />
    ))}
  </div>

</section>

<script>
  const strip  = document.getElementById('gallery-strip') as HTMLElement;
  const dots   = document.querySelectorAll<HTMLElement>('#gallery-dots button');
  const REAL   = 10;
  const TOTAL  = 11; // 10 + clon
  const STEP   = 100 / TOTAL; // % por slide (11.11…%)

  let current   = 0;
  let resetting = false;

  function updateDots(index: number) {
    dots.forEach((d, i) => {
      const active = i === index;
      d.style.width  = active ? '1rem' : '0.375rem';
      d.style.background = active ? 'var(--tw-bg-gold-500, #c8a355)' : 'var(--tw-bg-gold-200, #e8d5a3)';
    });
  }

  // Leer colores reales del primer dot para no hardcodear
  function dotColors() {
    const style = getComputedStyle(dots[0]);
    return { active: '#B8942A', inactive: '#E5D5A0' };
  }

  function applyDots(index: number) {
    dots.forEach((d, i) => {
      const on = i === index;
      d.classList.toggle('w-4',   on);
      d.classList.toggle('h-1.5', on);
      d.classList.toggle('w-2',   !on);
      d.classList.toggle('h-2',   !on);
      d.classList.toggle('bg-gold-500', on);
      d.classList.toggle('bg-gold-300', !on);
    });
  }

  function goTo(index: number, animate = true) {
    if (resetting) return;
    current = index;

    strip.style.transition = animate ? 'transform 700ms ease-in-out' : 'none';
    strip.style.transform  = `translateX(-${current * STEP}%)`;
    applyDots(current % REAL);

    // Al llegar al clon (índice 8), hacer snap silencioso al real (índice 0)
    if (animate && current === REAL) {
      resetting = true;
      setTimeout(() => {
        strip.style.transition = 'none';
        current = 0;
        strip.style.transform  = 'translateX(0%)';
        applyDots(0);
        resetting = false;
      }, 720);
    }
  }

  let timer = window.setInterval(() => goTo(current + 1), 3500);

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i);
      timer = window.setInterval(() => goTo(current + 1), 3500);
    });
  });

  // ── Swipe / drag ──────────────────────────────────────────────
  const container = strip.parentElement as HTMLElement;
  const THRESHOLD = 40; // px mínimos para contar como swipe
  let dragStart = 0;
  let isDragging = false;

  function resetTimer() {
    clearInterval(timer);
    timer = window.setInterval(() => goTo(current + 1), 3500);
  }

  function onDragStart(x: number) {
    if (resetting) return;
    dragStart = x;
    isDragging = true;
    strip.style.transition = 'none';
  }

  function onDragEnd(x: number) {
    if (!isDragging) return;
    isDragging = false;
    const delta = dragStart - x;
    if (Math.abs(delta) >= THRESHOLD) {
      goTo(delta > 0
        ? Math.min(current + 1, REAL)   // swipe izquierda → siguiente
        : Math.max(current - 1, 0));     // swipe derecha  → anterior
      resetTimer();
    } else {
      // Snap de vuelta si no llega al umbral
      strip.style.transition = 'transform 300ms ease-out';
      strip.style.transform  = `translateX(-${current * STEP}%)`;
    }
  }

  // Touch
  container.addEventListener('touchstart', (e) => onDragStart(e.touches[0].clientX), { passive: true });
  container.addEventListener('touchend',   (e) => onDragEnd(e.changedTouches[0].clientX));

  // Mouse (desktop)
  container.addEventListener('mousedown', (e) => { e.preventDefault(); onDragStart(e.clientX); });
  window.addEventListener('mouseup',   (e) => onDragEnd(e.clientX));
  container.style.cursor = 'grab';
  container.addEventListener('mousedown', () => { container.style.cursor = 'grabbing'; });
  window.addEventListener('mouseup',      () => { container.style.cursor = 'grab'; });
</script>
