---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Blessing from '../components/Blessing.astro';
import Countdown from '../components/Countdown.astro';
import DressCode from '../components/DressCode.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import GiftSection from '../components/GiftSection.astro';
import RSVP from '../components/RSVP.astro';
import Footer from '../components/Footer.astro';
import FloralDivider from '../components/FloralDivider.astro';
import Calendar from '../components/Calendar.astro';
---

<Layout>
  <Hero />
  <FloralDivider />
  <Blessing />
  <Countdown />
  <FloralDivider variant="corners" />
  <Calendar />
  <DressCode />
  <FloralDivider />
  <Gallery />
  <Location />
  <GiftSection />
  <FloralDivider variant="corners" />
  <RSVP />
  <Footer />
</Layout>
